# --- Norish ---
NORISH_URL=https://norish.example.lan
NORISH_API_KEY=            # Norish → account settings → API keys
NORISH_STORE_NAME=Wegmans  # groceries assigned to this Norish store get synced

# --- Wegmans (Abingdon / Bel Air store) ---
WEGMANS_STORE_NUMBER=53
WEGMANS_STORE_KEY=53-BEL-AIR

# --- Behaviour ---
SYNC_INTERVAL=120          # seconds between passes
DRY_RUN=false              # true = log what would change, touch nothing
# Optional: HA webhook (automation with a webhook trigger) pinged when Wegmans sign-in expires
HA_WEBHOOK_URL=
